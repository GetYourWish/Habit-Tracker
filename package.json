{
  "name": "habit-tracker-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first habit tracker for desktop & Android — build routines that stick",
  "workspaces": [
    "packages/*",
    "desktop",
    "mobile"
  ],
  "scripts": {
    "dev": "npm run dev --workspace desktop",
    "start": "npm run start --workspace desktop",
    "build": "npm run build --workspace desktop",
    "dist:win": "npm run dist:win --workspace desktop",
    "test": "npm run test --workspace @habit-tracker/core && npm run test --workspace desktop",
    "lint": "eslint . && npm run lint --workspaces --if-present",
    "test:core": "npm run test --workspace @habit-tracker/core",
    "test:core:rn": "npm run test --workspace @habit-tracker/mobile",
    "test:desktop": "npm run test --workspace desktop",
    "check:core-pin": "node scripts/check-core-pin.cjs"
  },
  "license": "MIT",
  "dependencies": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^23.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
